# ZARMS Tec Frontend Environment Variables

# Backend API Configuration
VITE_API_BASE=http://127.0.0.1:8000/backend/index.php?request=

# Environment (development | production)
# - development: Shows detailed error logs in console
# - production: Hides technical errors from console
VITE_APP_ENV=development

# Development server port
VITE_DEV_SERVER_PORT=5173
